          <label>Путь:</label>
          <defaultValue>$(user)/wordbook</defaultValue>
        </textBox>
        <checkBox refId="WritePathFinal">Окончательное</checkBox>
        <text>UserPaths файлов словарей</text>
        <textBox refId="UserPathsValue">
          <label>Список путей:</label>
          <defaultValue>$(inst)/share/wordbook $(inst)/share/wordbook/$(vlang) $(user)/wordbook</defaultValue>
        </textBox>
        <checkBox refId="UserPathsFinal">Окончательное</checkBox>
      </presentation>
      <presentation id="Gallery">
        <text>WritePath файлов галереи. Это расположение, в которое записываются новые пользовательские файлы.</text>
        <textBox refId="WritePathValue">
          <label>Путь:</label>
          <defaultValue>$(user)/gallery</defaultValue>
        </textBox>
        <checkBox refId="WritePathFinal">Окончательное</checkBox>
